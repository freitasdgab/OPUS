// =============================================================================
// PROJETO OPUS - DIAGRAMA DE ENTIDADE E RELACIONAMENTO (DER ATUALIZADO)
// Tabelas ativas e 100% interligadas para documentação do TCC
// (Removidos: batalhas_amigos, vw_amigos_usuario, grupos_batalha, grupo_membros)
// Cole todo este código diretamente no editor do site: https://dbdiagram.io
// =============================================================================

// -----------------------------------------------------------------------------
// 1. NÚCLEO PEDAGÓGICO / CONTEÚDO DO CURSO
// -----------------------------------------------------------------------------

Table divisoes {
  id int [pk]
  nome varchar(50) [not null]
  tema varchar(100) [not null]
  descricao varchar(500)
  secao_inicio int [not null]
  secao_fim int [not null]
  icone varchar(50)
  cor varchar(7)
  badge varchar(50)
}

Table unidades {
  numero int [pk]
  divisao_id int [not null]
  titulo varchar(50) [not null]
  nome varchar(100) [not null]
  descricao varchar(255)
  cor varchar(7)
  mascote varchar(100)
  guia_texto text
  guia_codigo text
  total_licoes tinyint [default: 5]
}

Table desafios {
  unidade_numero int [pk]
  badge varchar(100)
  heading varchar(200)
  intro text
  missao text
  alvo_visual varchar(255)
  dica_texto text
  dica_codigo text
  arquivo varchar(100)
  codigo_inicial text
  validador_js text
  mensagem_ajuste text
}

Table licoes {
  id int [pk, increment]
  unidade_numero int [not null]
  licao_numero int [not null]
  titulo varchar(200) [not null]
  texto_explicativo text [not null]
  codigo_exemplo text
  criado_em timestamp
}

Table perguntas {
  id int [pk, increment]
  licao_id int [not null]
  pergunta_texto text [not null]
  codigo_contexto text
  tipo varchar(50) [default: 'multipla_escolha']
  alternativa_a varchar(500)
  alternativa_b varchar(500)
  alternativa_c varchar(500)
  alternativa_correta varchar(255)
  criado_em timestamp
}

// -----------------------------------------------------------------------------
// 2. NÚCLEO DE USUÁRIOS E GAMIFICAÇÃO
// -----------------------------------------------------------------------------

Table usuarios {
  id int [pk, increment]
  nome varchar(100) [not null]
  email varchar(150) [unique, not null]
  senha varchar(255) [not null]
  xp int [default: 0]
  trofeus int [default: 0]
  dificuldade varchar(50) [default: 'Iniciante']
  foto_perfil text
  criado_em timestamp
  dias_fogo int [default: 0]
  vidas int [default: 3]
  vidas_proxima_em datetime
  ultima_atividade date
  nivel_acesso varchar(20) [default: 'comum']
  cor_fundo varchar(20)
  username varchar(50) [unique]
  google_id varchar(100)
  foto_google varchar(500)
  link_github varchar(255)
  link_instagram varchar(255)
  link_facebook varchar(255)
  link_youtube varchar(255)
  link_email varchar(255)
  link_linkedin varchar(255)
  projeto_titulo_1 varchar(255)
  projeto_url_1 varchar(255)
  pais varchar(50) [default: 'Brasil']
  pais_codigo varchar(10) [default: 'br']
}

Table progresso_usuario {
  id int [pk, increment]
  usuario_id int [not null]
  unidade_numero int [not null]
  status varchar(20) [default: 'trancado']
  licoes_concluidas int [default: 0]
  atualizado_em timestamp
}

Table acertos_diarios {
  id int [pk, increment]
  usuario_id int [not null]
  data_dia date [not null]
  acertos int [default: 0]
}

Table missoes_diarias_usuario {
  id int [pk, increment]
  usuario_id int [not null]
  data_ref date [not null]
  xp_ganho int [default: 0]
  licoes_concluidas int [default: 0]
  licoes_perfeitas int [default: 0]
  criado_em timestamp
  atualizado_em timestamp
}

Table bau_recompensas {
  id int [pk, increment]
  usuario_id int [not null]
  unidade_numero int [not null]
  tipo_recompensa varchar(50) [default: 'misto']
  xp_ganho int [default: 50]
  vidas_ganhas int [default: 0]
  resgatado_em timestamp
}

Table recuperacao_senha {
  id int [pk, increment]
  email varchar(255) [not null]
  codigo varchar(6) [not null]
  expira_em datetime [not null]
  usado boolean [default: false]
  criado_em timestamp
}

// -----------------------------------------------------------------------------
// 3. NÚCLEO DE TROFÉUS E CONQUISTAS
// -----------------------------------------------------------------------------

Table catalogo_trofeus {
  slug varchar(80) [pk]
  nome varchar(100) [not null]
  descricao varchar(255)
  listado boolean [default: false]
  ordem int [default: 0]
  icone varchar(60)
  imagem varchar(255)
  cor varchar(30)
  raridade varchar(20) [default: 'comum']
  criado_em timestamp
}

Table user_trofeus {
  id int [pk, increment]
  user_id int [not null]
  trofeu_slug varchar(80) [not null]
  conquistado_em timestamp
}

Table conquistas_usuario {
  id int [pk, increment]
  usuario_id int [not null]
  conquista_slug varchar(80) [not null]
  data_desbloqueio datetime
}

// -----------------------------------------------------------------------------
// 4. NÚCLEO DE LIGAS SEMANAIS
// -----------------------------------------------------------------------------

Table ligas_grupos {
  id int [pk, increment]
  divisao varchar(20) [not null]
  semana_ref date [not null]
  capacidade int [default: 30]
  criado_em datetime
}

Table ligas_usuario {
  id int [pk, increment]
  usuario_id int [not null]
  divisao varchar(20) [default: 'bronze']
  grupo_id int [not null]
  xp_semana int [default: 0]
  posicao_semana_anterior int
  ultima_atualizacao datetime
}

Table ligas_historico {
  id int [pk, increment]
  usuario_id int [not null]
  divisao_anterior varchar(20)
  divisao_nova varchar(20)
  resultado varchar(20)
  posicao_final int
  xp_final int
  semana_ref date
  criado_em timestamp
}

// -----------------------------------------------------------------------------
// 5. NÚCLEO SOCIAL, AMIGOS E CHAT
// -----------------------------------------------------------------------------

Table seguidores {
  id int [pk, increment]
  seguidor_id int [not null]
  seguido_id int [not null]
  data_criacao datetime
}

Table pedidos_conexao {
  id int [pk, increment]
  remetente_id int [not null]
  destinatario_id int [not null]
  status varchar(20) [default: 'pendente']
  data_criacao datetime
  notificado_aceite boolean [default: false]
  data_resposta datetime
  viraram_amigos boolean [default: false]
}

Table chat_mensagens {
  id int [pk, increment]
  remetente_id int [not null]
  destinatario_id int [not null]
  mensagem text
  status_leitura varchar(20) [default: 'nao_lido']
  data_envio datetime
}

// =============================================================================
// RELACIONAMENTOS (CARDINALIDADES E CHAVES ESTRANGEIRAS)
// =============================================================================

// Conteúdo e Módulos
Ref: unidades.divisao_id > divisoes.id
Ref: desafios.unidade_numero - unidades.numero
Ref: licoes.unidade_numero > unidades.numero
Ref: perguntas.licao_id > licoes.id

// Progresso e Usuário
Ref: progresso_usuario.usuario_id > usuarios.id
Ref: progresso_usuario.unidade_numero > unidades.numero
Ref: acertos_diarios.usuario_id > usuarios.id
Ref: missoes_diarias_usuario.usuario_id > usuarios.id
Ref: bau_recompensas.usuario_id > usuarios.id
Ref: bau_recompensas.unidade_numero > unidades.numero
Ref: recuperacao_senha.email > usuarios.email

// Troféus
Ref: user_trofeus.user_id > usuarios.id
Ref: user_trofeus.trofeu_slug > catalogo_trofeus.slug
Ref: conquistas_usuario.usuario_id > usuarios.id
Ref: conquistas_usuario.conquista_slug > catalogo_trofeus.slug

// Ligas
Ref: ligas_usuario.usuario_id > usuarios.id
Ref: ligas_usuario.grupo_id > ligas_grupos.id
Ref: ligas_historico.usuario_id > usuarios.id

// Social, Conexões e Chat
Ref: seguidores.seguidor_id > usuarios.id
Ref: seguidores.seguido_id > usuarios.id
Ref: pedidos_conexao.remetente_id > usuarios.id
Ref: pedidos_conexao.destinatario_id > usuarios.id
Ref: chat_mensagens.remetente_id > usuarios.id
Ref: chat_mensagens.destinatario_id > usuarios.id
